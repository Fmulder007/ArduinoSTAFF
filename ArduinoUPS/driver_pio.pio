; ArduinoUPS RP2040-Zero — четырёхвыходный Push-Pull с аппаратным fault input.
;
; GP0=A_H, GP1=A_L, GP2=B_H, GP3=B_L.
; GP5 — внутренняя fault-линия от PIO1 drain_monitor.
; Четыре выхода меняются атомарно обязательным side-set шириной 4 бита.
;
; TX FIFO:
;   1) activeLoopCount -> Y;
;   2) driverLoopCount -> ISR;
;   3) interphaseLoopCount -> OSR.
;
; JMP PIN опрашивает GP5 в активных петлях обоих плеч.
; При GP5=1 PIO переходит в emergency: NORMAL=1010 + IRQ1.
; NORMAL=1010 включает нижние входы драйверов и закрывает силовые MOSFET.

.program ups_driver
.side_set 4

    pull block side 0b1010
    mov y, osr side 0b1010
    pull block side 0b1010
    mov isr, osr side 0b1010
    pull block side 0b1010
    set pins, 0b1010 side 0b1010

.wrap_target
period_boundary:
    wait 0 irq 0 side 0b1010

    ; Полупериод A.
    mov x, isr side 0b1000
a_prepare_wait:
    jmp x--, a_prepare_wait side 0b1000

    mov x, y side 0b1001
    nop side 0b1001
a_active_check:
    jmp pin emergency side 0b1001
    jmp x--, a_active_check side 0b1001

    mov x, isr side 0b1000
a_turnoff_wait:
    jmp x--, a_turnoff_wait side 0b1000

    ; NOP здесь уравнивает эту паузу с WAIT на wrap-границе после B.
    nop side 0b1010
    mov x, osr side 0b1010
a_interphase_wait:
    jmp x--, a_interphase_wait side 0b1010

    ; Полупериод B.
    mov x, isr side 0b0010
b_prepare_wait:
    jmp x--, b_prepare_wait side 0b0010

    mov x, y side 0b0110
    nop side 0b0110
b_active_check:
    jmp pin emergency side 0b0110
    jmp x--, b_active_check side 0b0110

    mov x, isr side 0b0010
b_turnoff_wait:
    jmp x--, b_turnoff_wait side 0b0010

    mov x, osr side 0b1010
b_interphase_wait:
    jmp x--, b_interphase_wait side 0b1010
.wrap

emergency:
    irq set 1 side 0b1010
emergency_hold:
    jmp emergency_hold side 0b1010
