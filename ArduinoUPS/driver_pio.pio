; ArduinoUPS RP2040-Zero — генератор A/B.
; PIO0 SM0. GP0..GP3 — атомарные состояния драйверов.
; Контроль аварии выполняет SM1 того же PIO0.

.program ups_driver
.side_set 4

.wrap_target
period_boundary:
    wait 0 irq 0 side 0b1010

    ; Плечо A: подготовка, активный интервал, выключение.
    mov x, isr side 0b1000
a_prepare:
    jmp x--, a_prepare side 0b1000

    mov x, y side 0b1001
a_active:
    jmp x--, a_active side 0b1001

    mov x, isr side 0b1000
a_turnoff:
    jmp x--, a_turnoff side 0b1000

    ; Один дополнительный такт выравнивает межфазную паузу A->B
    ; с паузой B->A, в которую входит WAIT на границе периода.
    mov x, osr side 0b1010 [1]
a_interphase:
    jmp x--, a_interphase side 0b1010

    ; Плечо B.
    mov x, isr side 0b0010
b_prepare:
    jmp x--, b_prepare side 0b0010

    mov x, y side 0b0110
b_active:
    jmp x--, b_active side 0b0110

    mov x, isr side 0b0010
b_turnoff:
    jmp x--, b_turnoff side 0b0010

    mov x, osr side 0b1010
b_interphase:
    jmp x--, b_interphase side 0b1010
.wrap
