; ArduinoUPS RP2040-Zero — контроль датчиков стоков.
; PIO0 SM1. Программа загружается по адресу 17..31 в общую память PIO0.
; GP0/GP2 — наблюдение за началом активных интервалов A/B.
; GP27/GP28 — два датчика стоков.
; При 00 SM1 аппаратно перехватывает GP0..GP3 через optional side-set:
; SM1 имеет более высокий приоритет вывода, чем SM0.

.program drain_monitor
.side_set 4 opt

.wrap_target
wait_a:
    wait 1 gpio 0
    mov x, isr
quarter_a_delay:
    jmp x--, quarter_a_delay

    mov osr, pins
    out x, 2
    jmp !x, fault

wait_b:
    wait 1 gpio 2
    mov x, isr
quarter_b_delay:
    jmp x--, quarter_b_delay

    mov osr, pins
    out x, 2
    jmp !x, fault

    jmp wait_a

fault:
    ; Side-set NORMAL и IRQ1 устанавливаются одной инструкцией.
    irq set 1 side 0b1010

fault_hold:
    ; SM1 непрерывно удерживает NORMAL и выигрывает арбитраж GP0..GP3.
    jmp fault_hold side 0b1010
.wrap
